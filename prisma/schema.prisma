generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  COORDINACION
  EQUIPO
  ROOKIE
}

enum MemberStatus {
  ACTIVO
  HIATUS
}

enum ProjectStatus {
  ACTIVO
  EN_PAUSA
  PLANIFICACION
  DESARROLLO
  TRASPASO
}

enum Priority {
  ALTA
  MEDIA
  BAJA
}

enum FeatureStatus {
  HECHO
  EN_PROGRESO
  PENDIENTE
}

enum TaskType {
  FEATURE
  SPIKE
  FIX
  REFACTOR
  CHORE
  DOCS
}

enum KanbanColumn {
  PENDIENTE
  PROGRESO
  REVISAR
  REVISION
  LISTO
}

enum EventKind {
  REUNION
  ENTREGA
  HITO
  OTRO
}

enum DocSlotType {
  KICKOFF
  REQUERIMIENTOS
  TECNICO
  DECISIONES
  INFORME
}

/// Perfil de dominio e identidad de Better Auth en un mismo modelo
/// (user.modelName = "member", en src/lib/auth.ts). Premisa: todo Member se
/// origina en un login, no hay pre-registro.
///
/// Los campos de dominio requieren @default. Better Auth construye el INSERT
/// únicamente con sus campos (name, email, emailVerified, image, createdAt,
/// updatedAt); una columna NOT NULL sin default rompe el alta.
model Member {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  role     MemberRole   @default(ROOKIE)
  area     String       @default("Sin asignar")
  status   MemberStatus @default(ACTIVO)
  joinedAt DateTime     @default(now())
  birthday DateTime?
  skills   String[]     @default([])
  level    Int          @default(0)

  /// Bloques de la semana en que la persona declara estar disponible, como
  /// "LUN_MANANA". Los valores válidos viven en src/lib/api/member-fields.ts.
  availability String[] @default([])
  streak       Int      @default(0)

  /// Gate de acceso: nadie entra hasta que coordinación lo aprueba desde la
  /// pestaña "Pendientes" de /miembros.
  isVerifiedByCoordinator Boolean @default(false)

  sessions          Session[]
  accounts          Account[]
  projects          ProjectMember[]
  assignedTasks     Task[]              @relation("TaskAssignee")
  achievements      MemberAchievement[]
  standups          Standup[]
  timeEntries       TimeEntry[]
  documentsAuthored Document[]          @relation("DocumentAuthor")
  docVersions       DocVersion[]        @relation("DocVersionAuthor")
  eventsCreated     CalendarEvent[]     @relation("EventCreator")
}

model Project {
  id          String        @id @default(cuid())
  name        String
  client      String
  area        String
  description String
  status      ProjectStatus
  startDate   DateTime
  archived    Boolean       @default(false)

  members     ProjectMember[]
  features    Feature[]
  tasks       Task[]
  documents   Document[]
  actas       Acta[]
  events      CalendarEvent[]
  timeEntries TimeEntry[]
}

model ProjectMember {
  projectId String
  memberId  String
  role      String

  project Project @relation(fields: [projectId], references: [id])
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([projectId, memberId])
}

model Feature {
  id          String        @id @default(cuid())
  label       String
  projectId   String
  name        String
  priority    Priority
  status      FeatureStatus
  description String?

  project Project @relation(fields: [projectId], references: [id])
  tasks   Task[]

  @@unique([projectId, label])
}

model Task {
  id          String       @id @default(cuid())
  label       String
  projectId   String
  featureId   String?
  assigneeId  String?
  name        String
  type        TaskType
  active      Boolean
  column      KanbanColumn
  description String?

  project  Project  @relation(fields: [projectId], references: [id])
  feature  Feature? @relation(fields: [featureId], references: [id])
  assignee Member?  @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@unique([projectId, label])
}

/// content es Markdown (GFM) y es la versión actual; el historial vive en DocVersion.
/// A futuro, cuando se hagan secciones dentro del documento (contexto, alcance, decisiones,
/// por ejemplo), conviene migrarlo a JSON estructurado.
/// author/date son "quién y cuándo se creó el documento"; quién editó y cuándo está en
/// DocVersion.
model Document {
  id        String      @id @default(cuid())
  projectId String
  authorId  String?
  slot      DocSlotType
  filled    Boolean     @default(false)
  date      DateTime?
  content   String?

  project  Project      @relation(fields: [projectId], references: [id])
  author   Member?      @relation("DocumentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  versions DocVersion[]

  @@unique([projectId, slot])
}

/// Misma observación que en Document: content es Markdown y es la versión actual, con el
/// historial en DocVersion. date es la fecha de la reunión, no de una versión.
model Acta {
  id        String   @id @default(cuid())
  projectId String
  title     String
  date      DateTime
  content   String?

  project  Project      @relation(fields: [projectId], references: [id])
  versions DocVersion[]
}

/// Una versión guardada del contenido de un documento o de un acta: exactamente uno de
/// documentId / actaId (lo asegura un CHECK en la migración). Guarda el texto completo, no
/// un diff; el diff se calcula al mostrarlo (src/lib/diff.ts).
///
/// Cada guardado con cambios crea una versión, y una versión no se modifica después: por
/// eso no tiene updatedAt.
model DocVersion {
  id         String   @id @default(cuid())
  documentId String?
  actaId     String?
  authorId   String?
  content    String
  createdAt  DateTime @default(now())

  document Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  acta     Acta?     @relation(fields: [actaId], references: [id], onDelete: Cascade)
  author   Member?   @relation("DocVersionAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([documentId, createdAt])
  @@index([actaId, createdAt])
}

model Achievement {
  id   String @id @default(cuid())
  name String
  icon String

  members MemberAchievement[]
}

model MemberAchievement {
  memberId      String
  achievementId String
  unlockedAt    DateTime?

  member      Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@id([memberId, achievementId])
}

/// Uno por persona y semana (lunes a domingo en America/Santiago); reenviarlo
/// en la misma semana lo reemplaza. weekStart es el lunes como fecha sin hora a
/// medianoche UTC, leída con getters UTC (mismo criterio que los eventos de día
/// completo). La regla vive en src/lib/tiempo.ts.
model Standup {
  id        String   @id @default(cuid())
  memberId  String
  weekStart DateTime
  text      String /// ¿Qué hice esta semana?
  learned   String? /// ¿Qué aprendí?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, weekStart])
}

/// Horas que una persona registra contra un proyecto. Son personales: solo quien
/// las registró las ve, edita o borra. date es una fecha sin hora a medianoche
/// UTC, como Standup.weekStart. minutes va en múltiplos de 15.
///
/// Borrar el proyecto borra sus registros (deleteProject), igual que sus tareas.
model TimeEntry {
  id          String   @id @default(cuid())
  memberId    String
  projectId   String
  date        DateTime
  minutes     Int
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id])

  @@index([memberId, date])
}

/// Fechas: los eventos con hora guardan instantes UTC y el cliente los muestra en
/// su hora local. Los de día completo guardan fechas sin hora a medianoche UTC y
/// se leen con getters UTC, para que no se corran de día en Chile (UTC−3/−4).
/// La regla vive en src/lib/calendar.ts.
///
/// No hay recurrencia real: "repetir semanalmente" crea copias que comparten
/// seriesId, y editar o borrar actúa sobre una sola ocurrencia.
///
/// createdById es opcional para que borrar a un miembro no se lleve los eventos
/// que creó (mismo criterio que Document.author).
model CalendarEvent {
  id          String    @id @default(cuid())
  title       String
  description String?
  location    String? /// sala o link de videollamada
  kind        EventKind @default(OTRO)
  allDay      Boolean   @default(false)
  startsAt    DateTime /// allDay: medianoche UTC del primer día
  endsAt      DateTime /// exclusivo. allDay: medianoche UTC del día siguiente al último
  seriesId    String? /// copias generadas por "repetir semanalmente"
  projectId   String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy Member?  @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([startsAt])
  @@index([seriesId])
}

// ---------------------------------------------------------------------------
// Modelos gestionados por Better Auth. El modelo de usuario es Member.
// Session.userId y Account.userId referencian Member.id; el nombre del campo lo
// impone la librería y no admite renombre. Los ids no llevan @default: los
// genera Better Auth.
// ---------------------------------------------------------------------------

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member Member @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  member Member @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
