# Base de datos (Neon)
# DATABASE_URL usa el pooler y lo consume la app en runtime.
# DATABASE_URL_UNPOOLED lo usa el CLI de Prisma (ver prisma.config.ts).
#
# OJO: prisma.config.ts solo lee .env.local, no .env. Para migrar contra una
# rama que no sea producción, pon ahí las URLs de esa rama: .env.local tiene
# prioridad sobre .env tanto en Next como en el CLI de Prisma.
NEON_BRANCH=
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Better Auth
# BETTER_AUTH_SECRET: generar con `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth
# Crear en GitHub > Settings > Developer settings > OAuth Apps.
# Authorization callback URL (una OAuth App admite solo una; usa dos apps,
# una para local y otra para producción):
#   http://localhost:3000/api/auth/callback/github
#   https://<dominio-produccion>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
